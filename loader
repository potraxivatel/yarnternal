    '__   ___   ___ _  _ _____ ___ ___ _  _   _   _',
    '\\ \\ / /_\\ | _ \\ \\| |_   _| __| _ \\ \\| | /_\\ | |',
    ' \\ V / _ \\|   / .` | | | | _||   / .` |/ _ \\| |__',
    '  |_/_/ \\_\\_|_\\_|\\_| |_| |___|_|_\\_|\\_/_/ \\_\\____|',
