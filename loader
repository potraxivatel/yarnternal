        "\n  нет библиотеки rich — поставь её:\n\n"
        "      python3 -m pip install --user --break-system-packages rich\n\n"
    )
    sys.exit(1)

# ── пути ────────────────────────────────────────────────────────────────────
CONFIG_FILE = ROOT / "run" / "loader.conf"
